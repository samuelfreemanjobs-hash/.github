+#!/usr/bin/env bash
+# Build operator license zip from repo root.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+KIT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
+STAGING="$ROOT/dist/kit-staging"
+OUT="$ROOT/dist"
+DATE="$(date +%Y%m%d)"
+ZIP="$OUT/hunter-operator-license-kit-${DATE}.zip"
+
+cd "$ROOT"
+mkdir -p "$STAGING" "$OUT"
+
+echo "📦 Staging operator license kit..."
+rm -rf "$STAGING"
+mkdir -p "$STAGING"
+
+copy_path() {
+  local rel="$1"
+  if [[ -e "$ROOT/$rel" ]]; then
+    mkdir -p "$STAGING/$(dirname "$rel")"
+    cp -a "$ROOT/$rel" "$STAGING/$rel"
+  else
+    echo "  ⚠️  missing (skipped): $rel"
+  fi
+}
+
+# Core runtime
+copy_path server.js
+copy_path package.json
+copy_path package-lock.json
+copy_path Dockerfile
+copy_path docker-compose.yml
+copy_path railway.json
+copy_path .env.example
+cp -a "$ROOT/lib" "$STAGING/lib"
+cp -a "$ROOT/frontend" "$STAGING/frontend"
+cp -a "$ROOT/scripts" "$STAGING/scripts"
+mkdir -p "$STAGING/data"
+copy_path data/seed-leads.json
+cp -a "$ROOT/supabase" "$STAGING/supabase"
+cp -a "$ROOT/n8n" "$STAGING/n8n"
+cp -a "$ROOT/content" "$STAGING/content"
+cp -a "$ROOT/business" "$STAGING/business"
+cp -a "$ROOT/templates" "$STAGING/templates"
+cp -a "$ROOT/prompts" "$STAGING/prompts"
+cp -a "$KIT_DIR" "$STAGING/operator-license-kit"
+copy_path README.md
+copy_path GO_LIVE_RUNBOOK.md
+copy_path LAUNCH_STATUS.md
+copy_path project.md
+
+echo "📎 Creating $ZIP"
+rm -f "$ZIP"
+(cd "$STAGING" && zip -rq "$ZIP" .)
+rm -rf "$STAGING"
+echo "✅ Done: $ZIP ($(du -h "$ZIP" | cut -f1))"
