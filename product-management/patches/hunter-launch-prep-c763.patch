+#!/usr/bin/env bash
+# Quick brand swap — review diff before commit. Not exhaustive; see WHITE_LABEL.md
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+BRAND="${1:?Usage: $0 'New Brand Name'}"
+FROM="${2:-HUNTER Intelligence}"
+
+cd "$ROOT"
+echo "Replacing '$FROM' → '$BRAND' in key customer-facing files..."
+for f in frontend/index.html content/give-before-ask/index.html lib/spark-import.js; do
+  [[ -f "$f" ]] && sed -i "s/${FROM}/${BRAND}/g" "$f" && echo "  ✅ $f"
+done
+if [[ -f .env ]]; then
+  sed -i "s/^OPERATOR_BRAND=.*/OPERATOR_BRAND=${BRAND}/" .env || echo "OPERATOR_BRAND=${BRAND}" >> .env
+fi
+echo "Done. Run grep -r 'HUNTER' frontend content templates business for remaining strings."
